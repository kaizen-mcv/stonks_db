# Conexion a PostgreSQL
# Formato: postgresql+psycopg://USUARIO:PASSWORD@HOST:PUERTO/DB
# Ejemplo local (peer auth):
#   postgresql+psycopg://tu_usuario@/stonks_db
STONKS_DB_URL=postgresql+psycopg://USER@localhost:5432/stonks_db

# --- API keys (todas opcionales) ---

# FRED: https://fred.stlouisfed.org/docs/api/api_key.html
STONKS_FRED_API_KEY=

# CoinGecko demo key (30 req/min):
#   https://www.coingecko.com/en/api/pricing
STONKS_COINGECKO_KEY=

# UN Comtrade (comercio por producto HS):
#   https://comtradedeveloper.un.org
STONKS_COMTRADE_KEY=

# EIA (energia internacional):
#   https://www.eia.gov/opendata/register.php
STONKS_EIA_KEY=

# Tiingo: segunda fuente de precios (rellena huecos de yfinance y
# permite validacion cruzada). Plan gratuito: 1.000 peticiones/hora,
# 500 simbolos unicos al mes.
#   https://www.tiingo.com/account/api/token
STONKS_TIINGO_KEY=

# SEC EDGAR requiere email de contacto:
#   https://www.sec.gov/os/accessing-edgar-data
STONKS_SEC_CONTACT_EMAIL=
